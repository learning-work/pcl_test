<launch>
    <node pkg = "pcl_pkg" type = "map" name = "map">
        <param name = "cylinder_r" value = "0.5"/>
        <param name = "z_size" value = "1.0"/>
        <param name = "cube_r" value = "0.5"/>

    </node>

    <node pkg = "rviz" type = "rviz" name = "rviz"
        args = "-d $(find pcl_pkg)/config/map_rviz_config.rviz" />
    


</launch>